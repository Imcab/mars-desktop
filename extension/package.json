{
  "name": "mars",
  "displayName": "MARS",
  "description": "MARS framework support for FRC robot projects.",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/STZ-Robotics/Mars.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "frc",
    "first",
    "robotics",
    "mars",
    "networktables"
  ],
  "activationEvents": [
    "onLanguage:java",
    "workspaceContains:workspace-mars",
    "workspaceContains:vendordeps/Mars.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mars",
          "title": "MARS",
          "icon": "media/mars.svg"
        }
      ]
    },
    "views": {
      "mars": [
        {
          "id": "mars.projectView",
          "name": "Project",
          "icon": "media/mars.svg"
        },
        {
          "id": "mars.architectureView",
          "name": "Architecture",
          "icon": "media/mars.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mars.architectureView",
        "contents": "No MARS project is open.\n\nA folder counts as one when it has a workspace-mars directory, which is also what MARS Desktop checks before it will open a project.\n\n[Launch MARS Desktop](command:mars.launchDesktop)\n[Read the documentation](command:mars.openDocs)",
        "when": "!mars.hasProject"
      }
    ],
    "commands": [
      {
        "command": "mars.launchDesktop",
        "title": "Launch MARS Desktop",
        "category": "MARS",
        "icon": "$(dashboard)"
      },
      {
        "command": "mars.launchStudio",
        "title": "Launch Simulation Studio",
        "category": "MARS",
        "icon": "$(beaker)"
      },
      {
        "command": "mars.refresh",
        "title": "Rescan the project",
        "category": "MARS",
        "icon": "$(refresh)"
      },
      {
        "command": "mars.showTopics",
        "title": "Go to a NetworkTables topic",
        "category": "MARS",
        "icon": "$(symbol-key)"
      },
      {
        "command": "mars.openManifest",
        "title": "Open the Manifest",
        "category": "MARS"
      },
      {
        "command": "mars.openDocs",
        "title": "Open the documentation",
        "category": "MARS",
        "icon": "$(book)"
      },
      {
        "command": "mars.focusSidebar",
        "title": "Show the MARS sidebar",
        "category": "MARS"
      },
      {
        "command": "mars.reveal",
        "title": "Go to declaration",
        "category": "MARS"
      },
      {
        "command": "mars.pick",
        "title": "Go to one of several declarations",
        "category": "MARS"
      },
      {
        "command": "mars.copyTopic",
        "title": "Copy the NetworkTables topic",
        "category": "MARS"
      },
      {
        "command": "mars.renameTable",
        "title": "Rename a NetworkTables table",
        "category": "MARS",
        "icon": "$(replace-all)"
      },
      {
        "command": "mars.connectNetworkTables",
        "title": "Connect to NetworkTables",
        "category": "MARS",
        "icon": "$(radio-tower)"
      },
      {
        "command": "mars.disconnectNetworkTables",
        "title": "Disconnect from NetworkTables",
        "category": "MARS",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "mars.toggleNetworkTables",
        "title": "Connect to or disconnect from NetworkTables",
        "category": "MARS"
      },
      {
        "command": "mars.setTopic",
        "title": "Set a NetworkTables value",
        "category": "MARS"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mars.launchDesktop",
          "when": "view == mars.projectView",
          "group": "navigation@1"
        },
        {
          "command": "mars.launchStudio",
          "when": "view == mars.projectView",
          "group": "navigation@2"
        },
        {
          "command": "mars.refresh",
          "when": "view == mars.projectView",
          "group": "navigation@3"
        },
        {
          "command": "mars.connectNetworkTables",
          "when": "view == mars.architectureView && !mars.networkTablesConnected",
          "group": "navigation@1"
        },
        {
          "command": "mars.disconnectNetworkTables",
          "when": "view == mars.architectureView && mars.networkTablesConnected",
          "group": "navigation@1"
        },
        {
          "command": "mars.showTopics",
          "when": "view == mars.architectureView",
          "group": "navigation@2"
        },
        {
          "command": "mars.refresh",
          "when": "view == mars.architectureView",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mars.reveal",
          "when": "false"
        },
        {
          "command": "mars.pick",
          "when": "false"
        },
        {
          "command": "mars.copyTopic",
          "when": "false"
        },
        {
          "command": "mars.setTopic",
          "when": "false"
        },
        {
          "command": "mars.toggleNetworkTables",
          "when": "false"
        },
        {
          "command": "mars.showTopics",
          "when": "mars.hasProject"
        },
        {
          "command": "mars.openManifest",
          "when": "mars.hasProject"
        },
        {
          "command": "mars.renameTable",
          "when": "mars.hasProject"
        }
      ]
    },
    "snippets": [
      {
        "language": "java",
        "path": "./snippets/mars-java.json"
      }
    ],
    "configuration": {
      "title": "MARS",
      "properties": {
        "mars.desktopPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `mars-desktop` executable. Leave empty to look where the MARS installer puts it, and in this repository's build output."
        },
        "mars.simulationStudioPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `mars-sim-app` executable. Leave empty to look where the MARS installer puts it."
        },
        "mars.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show the links between a subsystem and its data, IO, requests and topics above each declaration."
        },
        "mars.networkTables.address": {
          "type": "string",
          "default": "",
          "markdownDescription": "Connect straight to this `host:port` instead of asking. Leave empty to be offered the simulator, the robot derived from the team number, the Driver Station and Systemcore."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\" && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.137.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ws": "^8.21.3"
  }
}

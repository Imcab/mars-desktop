{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MARS Installer",
  "version": "1.0.0",
  "identifier": "com.imadc.mars-installer",
  "build": {
    "frontendDist": "../installer/ui"
  },
  "app": {
    "windows": [
      {
        "title": "MARS Installer",
        "width": 760,
        "height": 580,
        "minWidth": 700,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* El bloque MARS se resuelve por alias: vite lo apunta a
       src/mars/index.tsx (edición Full) o a src/mars/index.tools.tsx (Tools).
       Para tsc siempre es el completo — las dos implementaciones se verifican
       igual porque cada una se asigna a `MarsSurface` en su propio archivo, y
       los dos archivos están dentro de `include`. */
    "baseUrl": ".",
    "paths": {
      "@mars": ["./src/mars/index.tsx"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

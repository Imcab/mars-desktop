<?xml version="1.0" ?>
<!--
  Mundo de verificación: una caja cayendo.
  
  Existe porque empty.sdf solo tiene cuerpos estáticos, y un suscriptor que
  recibe poses constantes no distingue "el transporte funciona" de "el motor
  está en pausa". Aquí la Z de la caja tiene que bajar, y eso solo pasa si la
  física corrió Y el mensaje viajó.
-->
<sdf version="1.11">
  <world name="mars">

    <physics name="250hz" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- Cubo de 20 cm y 2 kg soltado desde 3 m. Con gravedad -9.8 tarda unos
         780 ms en tocar el suelo, tiempo de sobra para que un suscriptor vea
         la Z bajar antes del impacto. -->
    <model name="box">
      <pose>0 0 3 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.01333</ixx><iyy>0.01333</iyy><izz>0.01333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MARS Simulation Studio",
  "version": "0.9.4",
  "identifier": "com.imadc.mars-sim",
  "build": {
    "frontendDist": "../app/ui"
  },
  "app": {
    "windows": [
      {
        "title": "MARS Simulation Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

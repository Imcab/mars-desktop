<?xml version="1.0"?>
<!--
  Los paneles de la ventana 3D de MARS Simulation Studio.

  Esto es la configuracion de la GUI de Gazebo: cada <plugin> es un panel. Se
  puede editar a mano, y desde la ventana se pueden abrir mas desde el menu de
  los tres puntos.

  Elegidos para FRC, no los de por defecto:

    Scene3D              el mundo. Es lo unico imprescindible.
    WorldControl         play / pausa / paso a paso
    WorldStats           real-time factor, tiempo de simulacion, FPS
    EntityTree           el arbol del mundo: modelos, links, joints, luces
    ComponentInspector   inspeccionar y EDITAR lo que se seleccione
    TransformControl     mover y girar cosas con el raton
    ViewAngle            vistas orto/perspectiva y encuadre rapido
    JointPositionController  mover joints a mano, para probar mecanismos
    Lights               anadir luces a la escena

  Lo que NO esta y es a proposito:
    Plotting / ImageDisplay      eso ya lo hace mars-desktop, mejor
    Shapes / Screenshot / etc    se abren desde el menu si hacen falta
-->
<window>
  <width>1800</width>
  <height>1000</height>
  <style
    material_theme="Dark"
    material_primary="#e8632a"
    material_accent="#e8632a"
    toolbar_color_light="#1c1f26"
    toolbar_text_color_light="#e6e8ec"
    toolbar_color_dark="#14161a"
    toolbar_text_color_dark="#e6e8ec"
    plugin_toolbar_color_light="#1c1f26"
    plugin_toolbar_text_color_light="#e6e8ec"
    plugin_toolbar_color_dark="#14161a"
    plugin_toolbar_text_color_dark="#e6e8ec"
  />
  <menus>
    <drawer default="false"/>
  </menus>
</window>

<!-- ==================== la escena ==================== -->
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>Scene</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>

  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.08 0.09 0.10</background_color>
  <!-- Desde una esquina y a 3 m, mirando al robot. Un swerve mide 0.72 m: la
       vista cenital desde 6 m lo dejaba como un punto en medio de la cancha.
       Desde aqui se le ven los modulos girar, que es de lo que se trata. -->
  <camera_pose>-2.6 -2.6 1.9 0 0.45 0.785</camera_pose>
  <camera_clip>
    <near>0.05</near>
    <far>250</far>
  </camera_clip>
</plugin>

<!-- Estos tres no dibujan nada: le dan a la escena el manejo de raton, el
     resaltado de seleccion y el marcado de entidades. Sin ellos la ventana se
     ve pero no se puede orbitar ni seleccionar. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<!-- ==================== barra inferior ==================== -->
<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <title>Control</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">72</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>

  <play_pause>true</play_pause>
  <step>true</step>
  <start_paused>false</start_paused>
</plugin>

<plugin filename="WorldStats" name="World stats">
  <gz-gui>
    <title>Stats</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">110</property>
    <property type="double" key="width">290</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="bottom" target="bottom"/>
    </anchors>
  </gz-gui>

  <!-- El real-time factor no es decorativo: por debajo de 1.0 sostenido, el
       codigo del robot corre su ciclo de 20 ms contra una fisica mas lenta y
       cualquier PID que se afine ahi no transfiere al robot real. -->
  <sim_time>true</sim_time>
  <real_time>true</real_time>
  <real_time_factor>true</real_time_factor>
  <iterations>true</iterations>
</plugin>

<!-- ==================== barra de herramientas ==================== -->
<plugin filename="TransformControl" name="Transform control">
  <gz-gui>
    <title>Transform</title>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">240</property>
    <property key="height" type="double">50</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="cardBackground" type="string">#1c1f26</property>
    <anchors target="3D View">
      <line own="left" target="left"/>
      <line own="top" target="top"/>
    </anchors>
  </gz-gui>
</plugin>

<plugin filename="ViewAngle" name="View angle">
  <gz-gui>
    <title>View</title>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">150</property>
    <property key="height" type="double">210</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="cardBackground" type="string">#1c1f26</property>
    <anchors target="3D View">
      <line own="right" target="right"/>
      <line own="top" target="top"/>
    </anchors>
  </gz-gui>
</plugin>

<!-- ==================== paneles laterales ==================== -->
<plugin filename="EntityTree" name="Entity tree">
  <gz-gui>
    <title>World</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
</plugin>

<plugin filename="ComponentInspector" name="Component inspector">
  <gz-gui>
    <title>Inspector</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
</plugin>

<!-- Estos dos van en pestana con el inspector en vez de apilados: con cuatro
     paneles abiertos a la vez el lateral se come la escena. -->
<plugin filename="JointPositionController" name="Joint position controller">
  <gz-gui>
    <title>Joints</title>
    <property type="string" key="state">docked_collapsed</property>
  </gz-gui>
</plugin>

<plugin filename="Lights" name="Lights">
  <gz-gui>
    <title>Lights</title>
    <property type="string" key="state">docked_collapsed</property>
  </gz-gui>
</plugin>

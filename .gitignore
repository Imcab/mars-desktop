# --- desktop/ : MARS Desktop -----------------------------------------------
# `node_modules` y `dist` ya salen arriba (sin barra, aplican a cualquier
# nivel), y lo de Rust lo lleva desktop/src-tauri/.gitignore, que se mudó con
# la carpeta.

# --- simulationstudio/ : MARS Simulation Studio -----------------------------
simulationstudio/build/
simulationstudio/install/
simulationstudio/dist/
simulationstudio/.gzsource/src/
# Persistencia que deja el servidor NT4 de nt-probe al correr los tests.
simulationstudio/networktables.json

# Bridge de simulacion
simulationstudio/bridge/target/
simulationstudio/app/target/
# Logs que dejan los procesos que lanza MARS Sim.
# Canchas 3D del Studio: 17 MB por cancha de asset de terceros, y la Field
# Library las reinstala en un clic desde las que ya tiene mars-desktop. Un
# mundo que referencia una cancha ausente sigue corriendo --- pierde el visual,
# no la fisica --- asi que ignorarlas degrada bien.
simulationstudio/fields/

simulationstudio/build/app-*.log
simulationstudio/build/app-*.err

# --- installer/ -------------------------------------------------------------
installer/target/
installer/gen/schemas/

# --- docs/ : mkdocs ---------------------------------------------------------
docs/site/
docs/.cache/

# Paquetes que produce scripts/package-release.mjs: son artefactos de build,
# viven en las releases de GitHub, no en el repo.
release/
